  "repository": "https://github.com/XxYouDeaDPunKxX/canon-boundary-guard-codex",
  "canonical_page": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/",
  "license": "CC BY-SA 4.0",
  "type": "codex-plugin",
  "deployment": {
    "platform": "GitHub Pages",
    "pages_type": "PROJECT_SITE",
    "source_branch": "gh-pages",
    "source_path": "/",
    "custom_domain": null,
    "site_root": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/",
    "discovery_root": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/"
  },
  "summary": "Codex plugin with a bundled skill that keeps project evidence, chat context, operator instructions, working hypotheses, and model assumptions in separate cognitive layers.",
  "primary_files": [
    ".agents/plugins/marketplace.json",
    "plugins/canon-boundary-guard-codex/.codex-plugin/plugin.json",
    "plugins/canon-boundary-guard-codex/hooks/hooks.json",
    "plugins/canon-boundary-guard-codex/skills/canon-boundary-guard/SKILL.md",
    "plugins/canon-boundary-guard-codex/skills/canon-boundary-guard/references/frame.md",
    "plugins/canon-boundary-guard-codex/skills/canon-boundary-guard/scripts/inject_frame.py",
    "plugins/canon-boundary-guard-codex/skills/canon-boundary-guard/agents/openai.yaml"
  ],
  "layers": [
    {
      "id": "L0",
      "name": "Evidence",
      "description": "Persistent or verified evidence."
    },
    {
      "id": "L1",
      "name": "Shaping",
      "description": "Conversation material not approved for persistence."
    },
    {
      "id": "L1A",
      "name": "Authorized Delta",
      "description": "Operator-approved material for the current turn before persistence."
    },
    {
      "id": "L2",
      "name": "Agent Control",
      "description": "Instructions that shape agent behavior, not project content."
    },
    {
      "id": "L2A",
      "name": "Codex Instruction Chain",
      "description": "AGENTS guidance and runtime instruction-chain material."
    },
    {
      "id": "L3",
      "name": "Model Prior",
      "description": "Unverified model memory, assumed conventions, or unstated framework behavior."
    }
  ],
  "discovery": {
    "llms_txt": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/llms.txt",
    "raw_manifest": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/raw-manifest.json",
    "sitemap": "https://xxyoudeadpunkxx.github.io/canon-boundary-guard-codex/sitemap.xml"
  }
}
